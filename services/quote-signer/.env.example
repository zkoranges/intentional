# Reservoir quote signer — copy to .env on the host. NEVER commit the real file.
# This file's values are placeholders only.

# Bind: localhost only. Public exposure is a tunnel/proxy in front.
HOST=127.0.0.1
PORT=8791

ETH_RPC_URL=https://your-mainnet-rpc.example
FACTOR_PRIVATE_KEY=0x<32-byte hex — the kernel's factorSigner>

# Fresh reviewed deployment. The retired v2 addresses are intentionally not
# accepted, even on a fork. Generate an active manifest from the fresh deploy.
KERNEL_ADDRESS=0x<fresh-kernel>
LIDO_ADAPTER_ADDRESS=0x<fresh-origination-adapter>
LIDO_UNSTETH_ADAPTER_ADDRESS=0x<fresh-existing-unsteth-adapter>
DEPLOYMENT_MANIFEST=/home/intentional/config/mainnet-active.json

# Shared secret required in the x-signer-secret header (>=32 chars).
# Generate: openssl rand -hex 32
SIGNER_SECRET=<32+ char secret shared with the Vercel proxy only>

# HARD per-quote ceiling, independent of measured reserve capacity. A
# compromised key can never authorize more than this in one quote.
MAX_QUOTE_WEI=6000000000000000
MIN_QUOTE_WEI=1000000000000000

# Pricing: gross factoring spread. MAX_SPREAD_BPS is the fat-finger guard.
SPREAD_BPS=25
MAX_SPREAD_BPS=100

# Quote lifetime; must stay inside the kernel's 15-minute maximum.
QUOTE_TTL_SECONDS=120

MAX_STETH_SHORTFALL_WEI=2
AUDIT_LOG=/home/impatience/logs/quote-audit.jsonl

# Optional provenance recorded in the (informational) evidence block.
AQUA_INTENT_PROOF_TX=0xdfb6b280dfe8255ee3d0c4c74243ab9d9d4637b412926f1a9731654340f64d37
