# Public build-time contract pins. Set only after deployments/mainnet-v2.json
# is committed, reviewed, and the active state passes read-only verification.
NEXT_PUBLIC_RESERVOIR_KERNEL=
NEXT_PUBLIC_RESERVOIR_LIDO_ADAPTER=

# Server-only Lido quote service. Leave all four empty to serve indicative
# quotes. Configure all four only for a reviewed, active, capped deployment.
ETH_RPC_URL=
# Use a dedicated capped quote signer. Never use a permanent admin/deployer key.
LIDO_QUOTE_SIGNER_PRIVATE_KEY=
FACTOR_ADDRESS=
RESERVOIR_KERNEL=
RESERVOIR_LIDO_ADAPTER=
LIDO_QUOTE_DISCOUNT_BPS=50
