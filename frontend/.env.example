# Public build-time contract pins for the reviewed deployment.
NEXT_PUBLIC_RESERVOIR_KERNEL=
NEXT_PUBLIC_RESERVOIR_LIDO_ADAPTER=

# Server-only Ethereum RPC used by /api/status. Never prefix this with
# NEXT_PUBLIC: the URL and provider credential must not enter the browser.
ETH_RPC_URL=

# No signing key belongs in this app. These optional server-only values point
# the keyless firm-quote proxy at the separately operated desk.
SIGNER_URL=
SIGNER_SECRET=

# The checked-in v2 pins identify a completed, permanently retired proof.
# Public firm quotes resume only on a fresh reviewed deployment and fresh
# signer after its funding and activation gates pass.
