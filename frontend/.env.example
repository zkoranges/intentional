# Public build-time contract pins. Set only after deployments/mainnet-v2.json
# is committed, reviewed, and the active state passes read-only verification.
NEXT_PUBLIC_RESERVOIR_KERNEL=
NEXT_PUBLIC_RESERVOIR_LIDO_ADAPTER=

# Public live quote policy. Market data comes from CoW and Lido; these values
# disclose the factor's underwriting policy. Firm quotes are signed offline.
LIDO_FUNDING_APR_BPS=1000
LIDO_RISK_BPS=15
LIDO_USER_EDGE_SHARE_BPS=5000
LIDO_CLAIM_GAS_UNITS=120000
