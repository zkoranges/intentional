# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Load it into your shell before running forge:
#   set -a; source .env; set +a
#
# Then sign with:  forge script ... --private-key "$PRIVATE_KEY"

# Deployer key, 32-byte hex with 0x prefix.
PRIVATE_KEY=

# Archive-capable Ethereum mainnet RPC.
ETH_RPC_URL=

# --- Mainnet scripts (required, or the script reverts) ---------------------
# Ack string: DEPLOY_PAUSED_UNFUNDED_RESERVOIR_V2 | FUND_VERIFIED_RESERVOIR_V2
#           | ACTIVATE_VERIFIED_RESERVOIR_V2
RESERVOIR_MAINNET_ACK=

# Code-free factor EOA — must match the address PRIVATE_KEY derives to.
FACTOR_ADDRESS=

# From the reviewed deployments/mainnet-v2.json (deploy step outputs these).
FUNDING_ACCOUNT_ADDRESS=
RESERVE_ADAPTER_ADDRESS=
KERNEL_ADDRESS=
LIDO_ADAPTER_ADDRESS=
EXPECTED_FUNDING_CODEHASH=
EXPECTED_RESERVE_CODEHASH=
EXPECTED_KERNEL_CODEHASH=
EXPECTED_LIDO_ADAPTER_CODEHASH=

# Wei amounts for fund/activate.
FUNDING_WETH_WEI=
MIN_CAPACITY_WEI=

# Verifier target: paused-unfunded | funded-paused | active
EXPECTED_RELEASE_STATE=

# --- Local/fork only (anvil throwaway keys) --------------------------------
# run-live-product-e2e.sh fills these from anvil automatically.
FACTOR_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
ANVIL_FACTOR_PRIVATE_KEY=
ANVIL_SELLER_PRIVATE_KEY=
ANVIL_CLAIM_RECEIVER=
