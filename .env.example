# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Load it into your shell before running the deployment tooling:
#   set -a; source .env; set +a
#
# Sign persistent-network transactions with a Foundry keystore, hardware
# wallet, or interactive signer. Do not put a private key in this file.

# Ethereum mainnet RPC. One provider is sufficient for the release process.
ETH_RPC_URL=

# Etherscan V2 API key used by `forge script --verify --verifier etherscan`.
ETHERSCAN_API_KEY=

# Optional preflight overrides. The defaults bind the reviewed dry run to
# deployer nonce 0 and require 2x the current estimated deployment gas cost.
EXPECTED_DEPLOYER_NONCE=0
DEPLOYMENT_GAS_UNITS=6606588
DEPLOYMENT_GAS_HEADROOM_BPS=20000

# --- Mainnet scripts -------------------------------------------------------
# Ack string for the operation being simulated or broadcast:
# DEPLOY_PAUSED_UNFUNDED_RESERVOIR_V2 | FUND_PAUSED_RESERVOIR_V2 |
# ACTIVATE_VERIFIED_RESERVOIR_V2
RESERVOIR_MAINNET_ACK=

# Code-free factor EOA — must match the selected keystore or hardware signer.
FACTOR_ADDRESS=

# From the reviewed deployments/mainnet-v2.json (deploy step outputs these).
FUNDING_ACCOUNT_ADDRESS=
RESERVE_ADAPTER_ADDRESS=
KERNEL_ADDRESS=
LIDO_ADAPTER_ADDRESS=
EXPECTED_FUNDING_CODEHASH=
EXPECTED_RESERVE_CODEHASH=
EXPECTED_KERNEL_CODEHASH=
EXPECTED_LIDO_ADAPTER_CODEHASH=

# Wei amounts for fund/activate.
FUNDING_WETH_WEI=
MIN_CAPACITY_WEI=

# Verifier target: paused-unfunded | funded-paused | active
EXPECTED_RELEASE_STATE=
