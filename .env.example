# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Load it into your shell before running the deployment tooling:
#   set -a; source .env; set +a
#
# Sign persistent-network transactions with a Foundry keystore, hardware
# wallet, or interactive signer. Do not put a private key, SIGNER_SECRET, or
# provider credential in any committed file.

# Ethereum mainnet RPC. One provider is sufficient for the release process.
ETH_RPC_URL=

# Etherscan V2 API key used by `forge script --verify --verifier etherscan`.
ETHERSCAN_API_KEY=

# Optional preflight overrides. The defaults bind the reviewed dry run to
# deployer nonce 0 and require 2x the current estimated deployment gas cost.
EXPECTED_DEPLOYER_NONCE=0
DEPLOYMENT_GAS_UNITS=6644864
DEPLOYMENT_GAS_HEADROOM_BPS=20000

# --- Mainnet scripts -------------------------------------------------------
# Ack string for the operation being simulated or broadcast:
# DEPLOY_PAUSED_UNFUNDED_RESERVOIR_V2 | FUND_PAUSED_RESERVOIR_V2 |
# ACTIVATE_VERIFIED_RESERVOIR_V2
RESERVOIR_MAINNET_ACK=

# Code-free factor EOA — must match the selected keystore or hardware signer.
FACTOR_ADDRESS=

# From the reviewed fresh pre-alpha deployment manifest.
FUNDING_ACCOUNT_ADDRESS=
RESERVE_ADAPTER_ADDRESS=
KERNEL_ADDRESS=
LIDO_ADAPTER_ADDRESS=
LIDO_UNSTETH_ADAPTER_ADDRESS=
EXPECTED_FUNDING_CODEHASH=
EXPECTED_RESERVE_CODEHASH=
EXPECTED_KERNEL_CODEHASH=
EXPECTED_LIDO_ADAPTER_CODEHASH=
EXPECTED_LIDO_UNSTETH_ADAPTER_CODEHASH=

# Wei amounts for fund/activate.
FUNDING_WETH_WEI=
MIN_CAPACITY_WEI=

# Verifier target — the releaseState lifecycle, in order:
#   paused-unfunded  deployed and sealed; both contracts paused, reserve empty
#   funded-paused    reserve funded at the explicit ceiling; settlement still paused
#   active           settlement unpaused; firm quotes are fillable
#   retired-paused   terminal: proof complete, reserve recovered, both contracts
#                    paused forever (immutable factor key exposed — never re-arm)
#   claim-collected  terminal: retired AND the outstanding unstETH claim was
#                    collected after Lido finalization
EXPECTED_RELEASE_STATE=

# --- Quote-desk deployment (operator shell only) --------------------------
# scripts/deploy-quote-signer.sh also requires DEPLOY_HOST, DEPLOY_SSH_KEY,
# FACTOR_PRIVATE_KEY, and SIGNER_SECRET. Inject the last two from a secure
# local secret source for that command only; do not save them in this file.
DEPLOY_HOST=
DEPLOY_SSH_KEY=
#
# The script accepts only a reviewed active manifest and verifies its code,
# bindings, both Lido adapters, and reserve capacity on mainnet before touching
# the VPS.
DEPLOYMENT_MANIFEST_PATH=deployments/mainnet-pre-alpha-001.json

# Vercel receives only:
#   server-only: ETH_RPC_URL, SIGNER_URL=https://quotes.intentional.so,
#                SIGNER_SECRET
#   public/build: NEXT_PUBLIC_RESERVOIR_KERNEL,
#                 NEXT_PUBLIC_RESERVOIR_LIDO_ADAPTER,
#                 NEXT_PUBLIC_RESERVOIR_LIDO_UNSTETH_ADAPTER
# FACTOR_PRIVATE_KEY belongs only on the loopback-bound VPS signer.
